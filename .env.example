# Copie para .env e ajuste. Todas as variáveis são opcionais; os valores abaixo são os padrões.

# Porta publicada no host (a do container é sempre 3000).
HOST_PORT=8085

# Imagem usada pelo compose. Padrão: construída localmente (pdf-unificador:local).
# Para usar a imagem publicada pelo CI:
# IMAGE=ghcr.io/rafaelguedes953/pdf-unificador:latest

# Limites de uso
MAX_FILES=20
MAX_FILE_MB=25
MAX_TOTAL_MB=100
MAX_PAGES=300
MAX_IMAGE_MEGAPIXELS=100
MAX_CONCURRENT_JOBS=2
SHARP_CONCURRENCY=2

# Limite de memória do container (ajuste conforme a RAM do seu Raspberry).
MEM_LIMIT=1g
